{
  "name": "bsp-desktop",
  "version": "2.4.2",
  "description": "Desktop shell (Electron) for Message WMB Worship Pro — projection window management, with NDI output planned as a later phase.",
  "author": "Multimédia Jésus Le Roc Tabernacle de Kananga",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "grandi": "^2.0.2"
  },
  "allowScripts": {
    "electron@32.3.3": true
  },
  "build": {
    "appId": "com.jrtkananga.messagewmbworshippro",
    "productName": "Message WMB Worship Pro",
    "icon": "app-src/assets/church/jrt-logo.png",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "relay-server.js",
      "http-server.js",
      "app-src/**/*",
      "node_modules/**/*"
    ],
    "afterPack": "scripts/afterPack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pactocipa",
        "repo": "message-wmb-worship-pro",
        "releaseType": "release"
      }
    ]
  }
}
